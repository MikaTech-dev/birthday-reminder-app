<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Birthday Reminder</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              black: '#09090b',      // Zinc 950
              surface: '#18181b',    // Zinc 900
              border: '#27272a',     // Zinc 800
              purple: '#7c3aed',     // Violet 600
              purpleHover: '#6d28d9' // Violet 700
            }
          }
        }
      }
    }
  </script>
  
  <style>
    /* Minimal Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #09090b; }
    ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #3f3f46; }
    
    /* Remove default date picker icon filter to match theme */
    ::-webkit-calendar-picker-indicator { filter: invert(1) opacity(0.5); cursor: pointer; }
  </style>
</head>
<body class="min-h-screen bg-brand-black text-zinc-300 flex flex-col items-center justify-center p-4">

  <main class="w-full max-w-4xl grid md:grid-cols-2 gap-0 bg-brand-surface rounded-xl border border-brand-border overflow-hidden shadow-[0_0_50px_-12px_rgba(124,58,237,0.15)]">

    <div class="p-8 border-b md:border-b-0 md:border-r border-brand-border flex flex-col justify-center">
      
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
          <i class="fa-solid fa-cake-candles text-brand-purple text-xl"></i>
          <h1 class="text-xl font-semibold text-white tracking-tight">Birthday Reminder</h1>
        </div>
        <p class="text-zinc-500 text-sm">Add a client to the automated registry.</p>
      </div>

      <% if (locals.error) { %>
        <div class="mb-6 p-3 bg-red-900/20 border border-red-900/50 text-red-200 text-sm rounded flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation"></i>
          <%= error %>
        </div>
      <% } %>

      <form action="/" method="POST" class="space-y-5">
        
        <div class="space-y-1.5">
          <label class="text-xs font-medium text-zinc-400 uppercase tracking-wide">Full Name</label>
          <div class="relative group">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-600 group-focus-within:text-brand-purple transition-colors">
              <i class="fa-regular fa-user"></i>
            </span>
            <input type="text" name="username" required placeholder="John Doe" 
              class="w-full bg-brand-black border border-brand-border rounded-lg py-2.5 pl-10 pr-3 text-sm text-zinc-200 focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all placeholder-zinc-700">
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-medium text-zinc-400 uppercase tracking-wide">Email Address</label>
          <div class="relative group">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-600 group-focus-within:text-brand-purple transition-colors">
              <i class="fa-regular fa-envelope"></i>
            </span>
            <input type="email" name="email" required placeholder="client@example.com" 
              class="w-full bg-brand-black border border-brand-border rounded-lg py-2.5 pl-10 pr-3 text-sm text-zinc-200 focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all placeholder-zinc-700">
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-medium text-zinc-400 uppercase tracking-wide">Date of Birth</label>
          <div class="relative group">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-600 group-focus-within:text-brand-purple transition-colors">
              <i class="fa-regular fa-calendar"></i>
            </span>
            <input type="date" name="dateOfBirth" required 
              class="w-full bg-brand-black border border-brand-border rounded-lg py-2.5 pl-10 pr-3 text-sm text-zinc-200 focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all placeholder-zinc-700">
          </div>
        </div>

        <button type="submit" class="w-full bg-brand-purple hover:bg-brand-purpleHover text-white font-medium py-2.5 rounded-lg shadow-lg shadow-purple-900/20 transition-all transform active:scale-[0.98] flex items-center justify-center gap-2 mt-2">
          <i class="fa-solid fa-plus text-xs"></i> Add Reminder
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-brand-border text-center">
        <p class="text-xs text-zinc-600">Emails sent daily at 07:00 AM</p>
      </div>
    </div>

    <div class="bg-[#121215] flex flex-col h-full max-h-[600px]">
      <div class="p-6 border-b border-brand-border flex justify-between items-center bg-brand-surface">
        <h2 class="text-sm font-semibold text-zinc-200">Registry</h2>
        <span class="text-xs bg-brand-border text-zinc-400 px-2 py-1 rounded border border-zinc-700">
          <%= users.length %> Total
        </span>
      </div>

      <div class="flex-1 overflow-y-auto p-4 space-y-2">
        <% if (users.length === 0) { %>
          <div class="h-full flex flex-col items-center justify-center text-zinc-600 space-y-3">
            <i class="fa-regular fa-folder-open text-3xl opacity-20"></i>
            <p class="text-sm">No data available</p>
          </div>
        <% } else { %>
          <% users.forEach(user => { %>
            <div class="group flex items-center justify-between p-3 rounded-lg border border-transparent hover:border-brand-border hover:bg-brand-black transition-all">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded bg-brand-border flex items-center justify-center text-xs font-bold text-zinc-400 group-hover:text-brand-purple group-hover:border group-hover:border-brand-purple/30 transition-colors">
                  <%= user.username.charAt(0).toUpperCase() %>
                </div>
                <div>
                  <h3 class="text-sm font-medium text-zinc-300 group-hover:text-white"><%= user.username %></h3>
                  <p class="text-xs text-zinc-500"><%= user.email %></p>
                </div>
              </div>

              <div class="text-right">
                <p class="text-xs font-mono text-zinc-500 mb-1">
                  <%= new Date(user.dateOfBirth).toLocaleDateString(undefined, { month: 'short', day: '2-digit' }) %>
                </p>
                <% const today = new Date();
                   const userDob = new Date(user.dateOfBirth);
                   if (today.getMonth() === userDob.getMonth() && today.getDate() === userDob.getDate()) { %>
                  <span class="inline-flex items-center gap-1 text-[10px] font-bold text-brand-purple bg-brand-purple/10 px-1.5 py-0.5 rounded border border-brand-purple/20">
                    <i class="fa-solid fa-bell animate-pulse"></i> TODAY
                  </span>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

  </main>
  <footer class="fixed bottom-0 left-0 right-0 p-3 border-t border-brand-border bg-brand-black/50 text-center">
    <p class="text-[14px] text-zinc-300 font-bold">Made with ⚡ by Mikatech/Crescentech</p>
  </footer>
</body>
</html>