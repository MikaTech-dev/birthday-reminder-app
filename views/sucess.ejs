<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Success - Birthday Reminder</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              black: '#09090b',
              surface: '#18181b',
              border: '#27272a',
              purple: '#7c3aed',
              purpleHover: '#6d28d9'
            }
          }
        }
      }
    }
  </script>

  <style>
    @keyframes scaleOnce {
      0% { transform: scale(1); }
      50% { transform: scale(1.12); }
      100% { transform: scale(1); }
    }
    .scale-once { animation: scaleOnce 0.6s ease-in-out; }
  </style>
</head>
<body class="min-h-screen bg-brand-black text-zinc-300 flex flex-col items-center justify-center p-4">

  <main class="w-full max-w-md bg-brand-surface border border-brand-border rounded-xl shadow-[0_0_50px_-12px_rgba(124,58,237,0.1)] p-10 text-center relative overflow-hidden">
    
    <div class="mx-auto mb-6 w-[80px] h-[80px] rounded-full block relative">
      <div class="w-full h-full rounded-full shadow-[inset_0px_0px_0px_#7c3aed] scale-once">
        <svg class="block origin-center w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
          <circle class="stroke-2 stroke-brand-purple fill-none" cx="26" cy="26" r="25" />
          <path class="stroke-2 stroke-brand-purple fill-none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
        </svg>
      </div>
    </div>

    <h1 class="text-2xl font-semibold text-white mb-2 tracking-tight">Success</h1>
    <p class="text-zinc-500 mb-8 text-sm leading-relaxed border-b border-brand-border pb-6">
      <%= message || 'The birthday reminder has been successfully added to the registry.' %>
    </p>
    
    <a href="/" class="group inline-flex items-center justify-center gap-2 w-full bg-brand-black border border-brand-border text-zinc-300 hover:text-white hover:border-brand-purple/50 px-6 py-3 rounded-lg font-medium transition-all duration-200">
      <i class="fa-solid fa-arrow-left text-xs group-hover:-translate-x-1 transition-transform"></i>
      Add Another Birthday
    </a>

  </main>
<footer class="fixed bottom-0 left-0 right-0 p-3 border-t border-brand-border bg-brand-black/50 text-center">
    <p class="text-[14px] text-zinc-300 font-bold">Made with ⚡ by Mikatech/Crescentech</p>
  </footer>

</body>
</html>